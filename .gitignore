# Dependencies
node_modules/

# Environment variables & secrets (keep .env private)
.env
.env.local
.env.*.local
.env.production
.env.development

# Dynamic user uploads (keep the folder via .gitkeep)
uploads/*
!uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data & process manager
.pm2/
pids
*.pid
*.seed

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Editor / IDE configuration
.vscode/
.idea/
*.sublime-workspace
*.swp
*.swo

# Temporary files
tmp/
temp/
